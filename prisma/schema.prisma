// KaSiHUB - Hybrid Ecosystem Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// MEMBERS - Central entity of the KasiHub ecosystem
// ============================================================
model Member {
  id              String   @id @default(cuid())
  profileNumber   String   @unique
  membershipType  String   // "INDIVIDUAL_ADULT" | "INDIVIDUAL_KIDS" | "COMPANY" | "NPO_NGO" | "SOLE_PROPRIETOR" | "FREE"
  // Citizenship / entity type — determines registration flow
  citizenshipType String?  // SA_CITIZEN_SA | FOREIGN_CITIZEN_SA | SA_CIPC_COMPANY | SA_SOLE_PROPRIETOR | SA_NPO_NGO | SA_CITIZEN_ABROAD | FOREIGN_CITIZEN_ABROAD | INTL_COMPANY
  firstName       String?
  lastName        String?
  companyName     String?
  companyRegNo    String?
  idPassport      String?  @unique
  sarsNumber      String?
  email           String   @unique
  country         String
  mobile          String
  addressLine     String?
  city            String?
  postalCode      String?
  profilePicture  String?
  beneficiaryName String?
  beneficiaryId   String?
  guardianName    String?  // for kids
  kycStatus       String   @default("PENDING") // PENDING | VERIFIED | REJECTED
  kycVerifiedAt   DateTime?
  subscriptionStatus String @default("PENDING") // PENDING | ACTIVE | LAPSED
  subscriptionAmount Float @default(140)
  subscriptionCurrency String @default("ZAR")
  paymentMethod   String?  // INSTAPAY | BANKUS | BANK | CARD
  taxThreshold    Boolean  @default(false) // true when earning > R7000/month
  monthlyEarnings Float    @default(0)
  nfcTagId        String?
  visaCardLast4   String?
  rootsBankAccount String?
  // InstaPay Gini integration
  instapayStatus      String   @default("NONE") // NONE | PENDING | VERIFIED
  instapayVerifiedAt  DateTime?
  instapayAccountRef  String?  // InstaPay account reference / merchant ID
  // Upline confirmation
  uplineProfileNumber String?
  uplineConfirmed     Boolean  @default(false)
  isAdmin         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  matrixNode      MatrixNode?
  shares          Share[]
  aureusShares    AureusShare[]
  subscriptions   Subscription[]
  transactions    Transaction[]
  marketplaceOrders MarketplaceOrder[]
  rootsBankShares RootsBankShare[]
  poolDistributions KasiPoolDistribution[]
  auditorNotifications AuditorNotification[]
  vouchers        Voucher[]
  referralsMade   Referral[] @relation("Referrer")
  referralsReceived Referral[] @relation("Referred")
  subscriptionNotifications SubscriptionNotification[]
}

// ============================================================
// ECOSYSTEM - 5 x 6 structure (was "Forced Matrix", renamed to Eco-System)
// ============================================================
model MatrixNode {
  id          String   @id @default(cuid())
  memberId    String   @unique
  member      Member   @relation(fields: [memberId], references: [id])
  parentId    String?  // upline / sponsor
  level       Int      // 0-5 (6 levels)
  position    Int      // 0-4 (5 positions per level) -- flattened index
  nodeIndex   Int      // global position in fill order (top-left to bottom-right)
  sponsorId   String?  // direct recruiter
  createdAt   DateTime @default(now())
}

// ============================================================
// SUBSCRIPTIONS - Monthly R140 membership payments
// ============================================================
model Subscription {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  amount      Float
  currency    String   // ZAR | USD
  method      String   // BANK | CARD | EFT
  status      String   @default("PAID") // PAID | PENDING | FAILED
  period      String   // e.g. "2025-01"
  createdAt   DateTime @default(now())
}

// ============================================================
// KASI SHARES - Class B shares sold in phases
// ============================================================
model Share {
  id              String   @id @default(cuid())
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id])
  phase           Int      // 1, 2, 3...
  pricePerShare   Float    // USD
  quantity        Int
  totalAmount     Float
  certificateNo   String   @unique
  prevCertificateNo String? // revoked certificate if upgraded
  status          String   @default("ACTIVE") // ACTIVE | REVOKED
  createdAt       DateTime @default(now())
}

// ============================================================
// ROOTS BANK SHARES - Pioneer 200 members program
// ============================================================
model RootsBankShare {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id])
  category      String   // KIDS_STUDENT | ADULT | PENSIONER
  sharePrice    Float    @default(500)
  membershipFee Float    // 50 or 200
  totalAmount   Float    // 550 or 700
  paymentRef    String?
  pioneerPool   Boolean  @default(true) // eligible for 1% PioneerPool
  status        String   @default("REGISTERED")
  createdAt     DateTime @default(now())
}

// ============================================================
// KASIPOOL - Equal-share profit distributions paid nightly
// ============================================================
model KasiPoolDistribution {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  amount      Float
  source      String   // MARKETPLACE | MALL | SUBSCRIPTION_DIFF | MANUAL
  poolType    String   @default("SHAREHOLDERS") // PIONEER | MARKETPLACE | SHAREHOLDERS
  payoutDate  DateTime @default(now())
  status      String   @default("PAID")
}

// ============================================================
// MARKETPLACE - Third-party products and services
// ============================================================
model MarketplaceProduct {
  id            String   @id @default(cuid())
  name          String
  description   String
  category      String   // GROCERIES | AIRTIME | UTILITIES | INSURANCE | TRANSPORT | HEALTH
  provider      String
  price         Float    // base price (paid members)
  freePrice     Float    @default(0) // price for free members (usually higher)
  currency      String   @default("ZAR")
  commissionPct Float    // commission/cashback % paid to KasiPool
  imageColor    String   // tailwind gradient seed
  rating        Float    @default(4.5)
  popular       Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model MarketplaceOrder {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  productId   String
  productName String
  amount      Float
  pricingTier String   @default("PAID") // PAID | FREE
  commission  Float    // amount sent to KasiPool
  status      String   @default("COMPLETED")
  createdAt   DateTime @default(now())
}

// ============================================================
// KASIMALL - Physical cashless mall transactions
// ============================================================
model MallTransaction {
  id          String   @id @default(cuid())
  nfcTagId    String
  storeName   String
  amount      Float
  // Smart contract silo splits
  costOfSale  Float    // supplier
  vat         Float
  sharePool   Float    // KasiShare pool
  kasiPool    Float    // KasiHub pool
  status      String   @default("COMPLETED")
  createdAt   DateTime @default(now())
}

// ============================================================
// TRANSACTIONS - General ledger for member wallets
// ============================================================
model Transaction {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  type        String   // SUBSCRIPTION | MATRIX_PAYOUT | POOL_PAYOUT | DIVIDEND | DAILY_SHARE | SHARE_PURCHASE | MARKETPLACE | MALL | PIONEER | KYC
  amount      Float    // positive = credit, negative = debit
  description String
  status      String   @default("COMPLETED")
  createdAt   DateTime @default(now())
}

// ============================================================
// SHARE PHASES - Phase configuration (editable by Exco)
// ============================================================
model SharePhase {
  id              String   @id @default(cuid())
  phase           Int      @unique
  pricePerShare   Float    // USD
  totalShares     Int
  soldShares      Int      @default(0)
  status          String   @default("OPEN") // OPEN | SOLD_OUT | UPCOMING
  bonusBuyOneGet  Boolean  @default(false) // Phase 1 BOGO
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// SILO CONFIG - Exco-editable mall payment split percentages
// ============================================================
model SiloConfig {
  id          String   @id @default(cuid())
  name        String   @unique
  percentage  Float
  description String?
  color       String
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// ============================================================
// SETTINGS - Key-value config (commission rates, thresholds, etc.)
// ============================================================
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON-encoded value
  category  String   @default("general")
  updatedAt DateTime @updatedAt
}

// ============================================================
// DIVIDEND DECLARATIONS - KasiMall dividend declarations
// ============================================================
model DividendDeclaration {
  id             String   @id @default(cuid())
  amount         Float    // total amount distributed
  totalShares    Int      // total eligible shares at declaration time
  perShareAmount Float    // amount / totalShares
  status         String   @default("DECLARED") // DECLARED | PAID
  declaredAt     DateTime @default(now())
  paidAt         DateTime?
}

// ============================================================
// AUREUS SHARES - Separate share class (Aureus Alliance)
// ============================================================
model AureusShare {
  id              String   @id @default(cuid())
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id])
  phase           Int
  pricePerShare   Float    // USD
  quantity        Int
  totalAmount     Float
  certificateNo   String   @unique
  prevCertificateNo String?
  status          String   @default("ACTIVE") // ACTIVE | REVOKED | RETRACTED
  createdAt       DateTime @default(now())
}

// ============================================================
// AUDITOR NOTIFICATIONS - Triggered when member exceeds R7000/month
// ============================================================
model AuditorNotification {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  monthEarnings Float  // the earnings that triggered the notification
  month       String   // e.g. "2025-07"
  sentAt      DateTime @default(now())
  status      String   @default("SENT") // SENT | ACKNOWLEDGED
}

// ============================================================
// VOUCHERS - Member vouchers pushed via WABlast (WhatsApp)
// ============================================================
model Voucher {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id])
  code          String   @unique
  title         String
  description   String
  provider      String
  value         Float    // voucher value in ZAR
  category      String   @default("GENERAL") // GROCERIES | AIRTIME | UTILITIES | DISCOUNT | GENERAL
  status        String   @default("ACTIVE") // ACTIVE | EXPIRED | REDEEMED
  issueDate     DateTime @default(now())
  expiryDate    DateTime
  anniversaryDate DateTime? // for anniversary-based voucher expiry
  wablastSent   Boolean  @default(false) // active vouchers pushed to WABlast
  expiringSent  Boolean  @default(false) // expiring reminder pushed to WABlast
  createdAt     DateTime @default(now())
}

// ============================================================
// SUBSCRIPTION NOTIFICATIONS - WhatsApp renewal reminders (5/3/1 days)
// ============================================================
model SubscriptionNotification {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  daysBefore  Int      // 5 | 3 | 1
  sentAt      DateTime @default(now())
  channel     String   @default("WHATSAPP") // WHATSAPP | SMS | EMAIL
  status      String   @default("SENT") // SENT | FAILED
  message     String
}

// ============================================================
// REFERRALS - Refer an Enabler program
// ============================================================
model Referral {
  id              String   @id @default(cuid())
  referrerId      String
  referrer        Member   @relation("Referrer", fields: [referrerId], references: [id])
  referredId      String?  // null until the referred person registers
  referred        Member?  @relation("Referred", fields: [referredId], references: [id])
  referralCode    String   @unique
  referredName    String
  referredEmail   String
  referredMobile  String
  status          String   @default("PENDING") // PENDING | REGISTERED | REWARDED
  rewardAmount    Float    @default(0) // referral bonus in ZAR
  createdAt       DateTime @default(now())
  convertedAt     DateTime?
}
